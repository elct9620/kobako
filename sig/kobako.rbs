module Kobako
  def self.to_name: (untyped name, String what) -> String

  def self.to_constant_name: (untyped name, String what) -> Symbol

  def self.constant_name?: (String name) -> bool

  def self.constant_path?: (String path) -> bool

  def self.reserved_path?: (String path) -> bool

  def self.paths_collide?: (String path, String bound) -> bool

  def self.max_handle_id: () -> Integer
end
