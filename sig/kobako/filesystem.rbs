module Kobako
  module Filesystem
    type mountable = Tmpfs | Bind | Overlay | _Readable

    type access = :read | :read_write

    # What a Filesystem written in Ruby answers to be mounted. One that
    # also answers _Listable lists its directories, and one answering
    # _Writable takes changes too; each method it lacks is refused alone.
    interface _Readable
      def open: (String path, Integer flags) -> _File
      def stat: (String path) -> _Stat
    end

    interface _Listable
      def children: (String path) -> Array[String]
    end

    interface _Writable
      def mkdir: (String path) -> void
      def rmdir: (String path) -> void
      def unlink: (String path) -> void
      def rename: (String from, String to, directory: bool?) -> void
    end

    # A file a Filesystem written in Ruby opened; +::File+ answers it. One
    # that also answers _WritableFile takes writes too, one answering
    # _AppendableFile takes appends, and any file may answer _SyncableFile
    # to flush or _ClosableFile to close.
    interface _File
      def pread: (Integer length, Integer offset) -> String?
      def size: () -> Integer
    end

    interface _WritableFile
      def pwrite: (String data, Integer offset) -> Integer
      def truncate: (Integer length) -> void
    end

    # Writes all of +data+ at the end in one step, answering where the file
    # then ends.
    interface _AppendableFile
      def append: (String data) -> Integer
    end

    interface _SyncableFile
      def fsync: () -> void
    end

    interface _ClosableFile
      def close: () -> void
    end

    # What a Filesystem written in Ruby's +stat+ answers, as +File::Stat+
    # does; an +ino+ of zero names no identity. One that also answers
    # _StatDevice names the device its +ino+ belongs to.
    interface _Stat
      def directory?: () -> boolish
      def size: () -> Integer
      def ino: () -> Integer
    end

    interface _StatDevice
      def dev: () -> Integer
    end

    class Tmpfs
      # A bare <tt>"path" => contents</tt> arrives as keywords, which RBS
      # cannot key by String; a Symbol keyword past +size+ and +nr_inodes+
      # raises ArgumentError.
      def initialize: (?Hash[String, String] files, ?size: Integer?, ?nr_inodes: Integer?, **String) -> void
    end

    class Bind
      def initialize: (String path) -> void
    end

    class Overlay
      def initialize: (lower: Array[mountable], ?upper: Tmpfs?) -> void
    end

  end
end
