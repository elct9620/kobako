module Kobako
  module Filesystem
    type kind = Memory | Temporary | Directory | Overlay

    type access = :read | :read_write

    class Memory
      def initialize: (?Hash[String, String] files) -> void
    end

    class Temporary
      def initialize: () -> void
    end

    class Directory
      def initialize: (String path) -> void
    end

    class Overlay
      def initialize: () -> void
      def layer: (kind filesystem, ?access: access) -> Overlay
    end

    KINDS: Array[Class]
  end
end
