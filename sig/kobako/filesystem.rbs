module Kobako
  module Filesystem
    type kind = Memory | Temporary | Directory | Overlay | _Readable

    type access = :read | :read_write

    # What a Filesystem written in Ruby answers to be mounted. One that
    # also answers _Listable lists its directories, and one answering
    # _Writable takes changes too; each method it lacks is refused alone.
    interface _Readable
      def open: (String path, Integer flags) -> _File
      def stat: (String path) -> _Stat
    end

    interface _Listable
      def children: (String path) -> Array[String]
    end

    interface _Writable
      def mkdir: (String path) -> void
      def rmdir: (String path) -> void
      def unlink: (String path) -> void
      def rename: (String from, String to, directory: bool?) -> void
    end

    # A file a Filesystem written in Ruby opened; +::File+ answers it. One
    # that also answers _WritableFile takes writes too, and any file may
    # answer _ClosableFile to flush and close.
    interface _File
      def pread: (Integer length, Integer offset) -> String?
      def size: () -> Integer
    end

    interface _WritableFile
      def pwrite: (String data, Integer offset) -> Integer
      def truncate: (Integer length) -> void
    end

    interface _ClosableFile
      def fsync: () -> void
      def close: () -> void
    end

    interface _Stat
      def directory?: () -> boolish
      def size: () -> Integer
    end

    class Memory
      # A bare <tt>"path" => contents</tt> arrives as keywords, which RBS
      # cannot key by String; a Symbol keyword past +limit+ and +inodes+
      # raises ArgumentError.
      def initialize: (?Hash[String, String] files, ?limit: Integer?, ?inodes: Integer?, **String) -> void
    end

    class Temporary
      def initialize: (?limit: Integer?, ?inodes: Integer?) -> void
    end

    class Directory
      def initialize: (String path) -> void
    end

    class Overlay
      def initialize: () -> void
      def layer: (kind filesystem, ?access: access) -> Overlay
    end

  end
end
