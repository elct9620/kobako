module Kobako
  module Outcome
    ORIGIN_SANDBOX: String
    ORIGIN_SERVICE: String

    type panic_fields = [String, String, String, Array[String]]

    def self?.reify: (Symbol kind, String payload, panic_fields? panic) -> Kobako::Codec::wire_value

    def self?.panic_error: (String details, panic_fields panic) -> (SandboxError | ServiceError)

    def self?.error_class: (String origin, String klass) -> (singleton(SandboxError) | singleton(ServiceError))

    def self?.trap_error: (Symbol kind) -> TrapError

    def self?.decode_value: (String payload) -> Kobako::Codec::wire_value

    def self?.decode_details: (String payload) -> Kobako::Codec::wire_value?

    def self?.wire_error: (String message, ?detail: String?) -> Transport::Error
  end
end
