module Kobako
  module Codec
    module ValueBudget
      SCALARS: Hash[Integer, Integer]

      COUNTS: Hash[Integer, [Integer, Integer]]

      LENGTHS: Hash[Integer, [Integer, Integer]]

      UINT: Hash[Integer, String]

      FLOATS: Regexp

      NAN_ENTRY: Integer

      FLOAT_FORMATS: Hash[Integer, String]

      def self.assert_within: (String bytes, Integer? budget) -> void

      def self.step: (String bytes, Integer pos) -> [Integer?, Integer]

      class Count
        class OpenContainer < Struct[untyped]
          attr_accessor held: Integer
          attr_accessor keyed: bool
          attr_accessor read: Integer
          attr_accessor nan_keys: Integer
          attr_accessor holds_nan: bool

          def self.new: (Integer held, bool keyed, Integer read, Integer nan_keys, bool holds_nan) -> OpenContainer
        end

        @bytes: String
        @budget: Integer
        @remaining: Integer
        @open: Array[OpenContainer]

        @ended: bool

        def initialize: (String bytes, Integer budget) -> void

        def run: () -> void

        private

        def count_value: (Integer pos, Integer children) -> void

        def close_value: (bool holds_nan) -> void

        def charge_key: (OpenContainer map) -> void

        def spend: (Integer values) -> void

        def map?: (Integer? marker) -> bool

        def nan?: (Integer? marker, Integer pos) -> bool
      end

      private

      def self.within_by_size?: (String bytes, Integer budget) -> bool

      def self.step_framed:(String bytes, Integer pos, Integer marker) -> [Integer?, Integer]

      def self.uint: (String bytes, Integer pos, Integer width) -> Integer
    end
  end
end
