module Kobako
  module Codec
    class State
      STATE_KEY: Symbol

      def self.current: () -> State

      def track_handles: [T] { () -> T } -> [T, bool]
      def record_handle!: () -> void
      def forbid_faults: [T] { () -> T } -> T
      def faults_forbidden?: () -> bool

      private

      def initialize: () -> void
    end
  end
end
