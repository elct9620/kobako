module Kobako
  module Codec
    class State
      STATE_KEY: Symbol

      def self.current: () -> State

      @carried_handle: bool
      @value_budget: Integer?

      attr_reader value_budget: Integer?

      def track_handles: [T] { () -> T } -> [T, bool]
      def record_handle: () -> void
      def within_value_budget: [T] (Integer? budget) { () -> T } -> T

      private

      def initialize: () -> void
    end
  end
end
