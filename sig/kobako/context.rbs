module Kobako
  class Context
    attr_reader usage: Kobako::Usage

    def initialize: (
      runtime: Kobako::Runtime,
      services: Kobako::Catalog::Services,
      snippets: Kobako::Catalog::Snippets,
      extensions: Kobako::Catalog::Extensions
    ) -> void

    def lookup: (Symbol | String path) -> untyped

    def stdout: () -> String

    def stderr: () -> String

    def stdout_truncated?: () -> bool

    def stderr_truncated?: () -> bool

    def eval: (String code) -> Kobako::Execution

    def run: (Kobako::Transport::Run run_envelope) -> Kobako::Execution

    private

    def dispatch_handler: () -> ^(String, Kobako::Transport::_GuestYielder) -> String

    def populate_observability!: (Kobako::Runtime::Snapshot snapshot) -> void

    def trap_class_for: (Kobako::TrapError err) -> singleton(Kobako::TrapError)

    def trap_error_for: (Kobako::Runtime::Snapshot snapshot, Symbol verb) -> Kobako::TrapError

    def build_execution: (untyped value) -> Kobako::Execution

    def settle_outcome: (Kobako::Runtime::Snapshot snapshot, Symbol verb) -> Kobako::Execution

    def invoke!: (Symbol verb) { () -> Kobako::Runtime::Snapshot } -> Kobako::Execution
  end
end
