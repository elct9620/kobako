module Kobako
  class Context
    def initialize: (
      runtime: Kobako::Runtime,
      services: Kobako::Catalog::Services,
      snippets: Kobako::Catalog::Snippets,
      extensions: Kobako::Catalog::Extensions
    ) -> void

    def bind: (Symbol | String path, untyped object) -> self

    def lookup: (Symbol | String path) -> untyped

    def eval: (String code) ?{ (Kobako::Context) -> void } -> Kobako::Execution

    def run: (Kobako::Transport::Run request) ?{ (Kobako::Context) -> void } -> Kobako::Execution

    private

    def collect_overrides: () { (Kobako::Context) -> void } -> void

    def dispatch_handler: () -> Kobako::Transport::dispatch_proc

    def populate_observability!: (Kobako::Runtime::Snapshot snapshot) -> void

    def trap_class_for: (Kobako::TrapError err) -> singleton(Kobako::TrapError)

    def trap_error_for: (Kobako::Runtime::Snapshot snapshot, Symbol verb) -> Kobako::TrapError

    def build_execution: (untyped value, failed: bool) -> Kobako::Execution

    def settle_outcome: (Kobako::Runtime::Snapshot snapshot, Symbol verb, Symbol? entrypoint) -> Kobako::Execution

    def invoke!: (Symbol verb, ?entrypoint: Symbol?) { () -> Kobako::Runtime::Snapshot } -> Kobako::Execution
  end
end
