module Kobako
  class Sandbox
    extend Forwardable

    attr_reader wasm_path: String
    attr_reader options: Kobako::SandboxOptions

    # Forwarded to @options via Forwardable#def_delegators.
    def timeout: () -> Float?
    def setup_timeout: () -> Float?
    def memory_limit: () -> Integer?
    def stdout_limit: () -> Integer?
    def stderr_limit: () -> Integer?
    def open_file_limit: () -> Integer?
    def profile: () -> Symbol
    def gvl: () -> Symbol

    # Every keyword beyond wasm_path forwards verbatim to
    # SandboxOptions.new (the caps + the profile floor).
    def initialize: (
      ?wasm_path: String?,
      **untyped options
    ) -> void

    def bind: (Symbol | String path, ?untyped object) -> Kobako::Sandbox

    def install: (*untyped extensions) -> Kobako::Sandbox

    def mount: (String at, Kobako::Filesystem::kind filesystem, ?access: Kobako::Filesystem::access) ?{ (String path, Kobako::Filesystem::access access) -> boolish } -> Kobako::Sandbox

    def preload: (code: String, name: Symbol | String) -> Kobako::Sandbox
               | (binary: String) -> Kobako::Sandbox

    def flag: (Symbol | String name, ?String value, ?advisory: bool) -> Kobako::Sandbox

    def run: (Symbol | String target, *untyped args, **untyped kwargs) ?{ (Kobako::Context) -> void } -> Kobako::Execution

    def eval: (String code) ?{ (Kobako::Context) -> void } -> Kobako::Execution

    private

    def build_runtime!: () -> Kobako::Runtime

    def new_invocation: () -> Kobako::Context

    def preamble: (Array[Kobako::Catalog::Snippets::tuple] snippets) -> Kobako::Context::preamble

    def refuse_once_invoked!: (String verb) -> void

    def begin_invocation!: () -> void
  end
end
