module Kobako
  module Transport
    module Dispatcher
      class UndefinedTargetError < StandardError
      end

      class UnreadableRequestError < Kobako::Codec::Error
      end

      BREAK_THROW: Symbol

      OWN_FAULTS: Hash[singleton(StandardError), String]

      def self.dispatch: (Kobako::Transport::Call call, Kobako::Transport::_ServiceResolver resolver, Kobako::Transport::_HandleTable handles, Kobako::Transport::BlockFailure failure, Kobako::Transport::_GuestYielder guest_yielder) -> [Symbol, String, String?]

      private

      def self.run: (Kobako::Transport::Call call, Kobako::Transport::_ServiceResolver resolver, Kobako::Transport::_HandleTable handles, Kobako::Transport::Yielder? yielder) -> untyped

      def self.decode_arguments: (String payload) -> [Kobako::Payload::Arguments, bool]

      def self.resolve_call_args: (Kobako::Payload::Arguments arguments, Kobako::Codec::_HandleTable handles, bool carried_handle) -> [Array[untyped], Hash[Symbol, untyped]]

      def self.caught_fault: (StandardError error, Kobako::Transport::BlockFailure failure) -> [String, String]

      def self.invoke: (Kobako::Transport::Exposure exposure, String method, Array[untyped] args, Hash[Symbol, untyped] kwargs, Kobako::Transport::Yielder? yielder) -> untyped

      def self.reject_unreachable!: (Kobako::Transport::Exposure exposure, Symbol name) -> void

      def self.resolve_arg: (untyped value, Kobako::Codec::_HandleTable handles) -> untyped

      def self.resolve_target: (String | Integer target, Kobako::Transport::_ServiceResolver resolver, Kobako::Transport::_HandleTable handles) -> Kobako::Transport::Exposure

      def self.resolve_path: (String path, Kobako::Transport::_ServiceResolver resolver) -> Kobako::Transport::Exposure

      def self.resolve_handle: (Integer id, Kobako::Transport::_HandleTable handles) -> Kobako::Transport::Exposure

      def self.encode_ok: (untyped value, Kobako::Codec::_HandleTable handles) -> String

      def self.fault: (String type, String message) -> [String, String]
    end
  end
end
