module Kobako
  module Transport
    class Yielder
      @guest_yielder: Kobako::Transport::_GuestYielder
      @break_tag: Symbol
      @handles: Kobako::Codec::_HandleTable
      @failure: Kobako::Transport::BlockFailure
      @active: bool

      def initialize: (Kobako::Transport::_GuestYielder guest_yielder, Symbol break_tag, Kobako::Codec::_HandleTable handles, Kobako::Transport::BlockFailure failure) -> void

      def yield: (*untyped args) -> untyped

      def to_proc: () -> Proc

      def invalidate: () -> void

      private

      def encode_args: (Array[untyped] args) -> String

      def decode_body: (String body) -> [untyped, bool]

      def restore: (untyped value, bool carried_handle) -> untyped
    end
  end
end
