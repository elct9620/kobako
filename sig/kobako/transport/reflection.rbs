module Kobako
  module Transport
    module Reflection
      GADGET_OWNERS: Array[Module]
      CALLABLE_ALLOW: Array[Symbol]

      def self.refusal: (Kobako::Transport::Exposure exposure, Symbol name) -> String?

      def self.authored?: (UnboundMethod method) -> bool

      private

      def self.ambient_copy?: (UnboundMethod method) -> bool

      def self.ambient_refusal: (untyped target, Symbol name) -> String?

      def self.defined_refusal: (untyped target, Symbol name, Module klass) -> String?

      def self.authored_for?: (untyped target, Symbol name, UnboundMethod method, Module klass) -> bool

      def self.service_refusal: (Symbol name) -> String

      def self.owner_refusal: (untyped target, Symbol name, Module owner) -> String?

      def self.lookup_class: (untyped target) -> Module

      def self.ambient_owner?: (Module owner, untyped target) -> bool
    end
  end
end
