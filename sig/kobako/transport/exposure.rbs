module Kobako
  module Transport
    class Exposure < Data
      PREDICATE: Symbol
      CALLABLE: Set[Symbol]
      NOTHING: Set[Symbol]

      attr_reader object: untyped
      attr_reader names: Set[Symbol]?

      def self.new: (object: untyped, names: Set[Symbol]?) -> Exposure
                  | (untyped, Set[Symbol]?) -> Exposure

      def self.of: (untyped object, ?Hash[Module, Set[Symbol]] surfaces) -> Exposure

      def initialize: (object: untyped, names: Set[Symbol]?) -> void

      def with: (?object: untyped, ?names: Set[Symbol]?) -> Exposure

      def ==: (untyped other) -> bool

      def hash: () -> Integer

      def exposes?: (Symbol name) -> bool

      private

      def self.narrows_itself?: (untyped object, Module klass) -> bool

      def self.resolve_default_names: (untyped object, Module klass, Hash[Module, Set[Symbol]] surfaces) -> Set[Symbol]

      def self.class_names: (untyped object, Module klass) -> Set[Symbol]

      def self.with_singleton: (untyped object, Set[Symbol] names) -> Set[Symbol]

      def self.authored_names:(Module owner) -> Array[Symbol]
    end
  end
end
