module Kobako
  module Network
    type protocol = :http | :tcp | :udp

    UNWRITTEN: Object

    def self.normalize_endpoint: (untyped host, untyped port, Hash[Symbol, untyped] written) ->
      [String, Integer, protocol, Array[Symbol | String | IPAddr], Array[HttpRule]]

    def self.normalize_rule: (bool allow, String? method, String path) -> [bool, String?, String]

    def self.validate_credential: (Credential credential) -> nil

    def self.validate_name: (String name) -> nil

    class Endpoint < Data
      attr_reader host: String
      attr_reader port: Integer
      attr_reader protocol: protocol
      attr_reader addresses: Array[Symbol | String | IPAddr]
      attr_reader rules: Array[HttpRule]

      def self.new: (host: untyped, port: untyped, ?protocol: untyped, ?addresses: untyped, ?rules: untyped) -> Endpoint

      def initialize: (host: untyped, port: untyped, ?protocol: untyped, ?addresses: untyped, ?rules: untyped) -> void
    end

    class Connection < Data
      attr_reader host: String
      attr_reader port: Integer
      attr_reader protocol: protocol

      def self.new: (host: String, port: Integer, protocol: protocol) -> Connection
    end

    class HttpRule
      @allow: bool

      def allow?: () -> bool
      attr_reader method: String?
      attr_reader path: String

      def initialize: (allow: boolish, method: untyped, path: untyped) -> void
    end

    class Rules
      @rules: Array[HttpRule]

      def initialize: () -> void

      def allow: (untyped method, untyped path) -> self

      def deny: (untyped method, untyped path) -> self

      def to_a: () -> Array[HttpRule]
    end

    class Credential
      @source: ^(Request) -> String?

      attr_reader placement: Symbol | String
      attr_reader placeholder: String

      def initialize: (Symbol | String placement, placeholder: untyped) ?{ (Request) -> String? } -> void

      def value: (Request request) -> String?
    end

    class Request
      attr_reader host: String
      attr_reader port: Integer
      attr_reader method: String
      attr_reader scheme: String
      attr_reader path: String
      attr_reader header_names: Array[String]

      def initialize: ([String, Integer] authority, String method, String scheme, String path, Array[String] header_names) -> void
    end

    class Builder
      HOOKS: Array[Symbol]

      @entry: untyped
      @endpoints: Array[Endpoint]
      @policies: Hash[Symbol, Array[^(untyped) -> boolish]]
      @credentials: Array[Credential]

      def initialize: (?untyped entry) -> void

      def credential: (Symbol | String placement, placeholder: untyped) ?{ (Request) -> String? } -> self

      def endpoint: (untyped host, port: untyped, ?protocol: untyped, ?addresses: untyped) ?{ (Rules) -> void } -> self

      def policy: (Symbol hook) ?{ (untyped) -> boolish } -> self

      def to_native: () -> [untyped, Array[Endpoint], Array[Credential], Hash[Symbol, Array[^(untyped) -> boolish]]]
    end
  end
end
