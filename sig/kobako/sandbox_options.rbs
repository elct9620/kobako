module Kobako
  class SandboxOptions < Data
    VALUE_BYTES: Integer

    attr_reader timeout: Float?
    attr_reader setup_timeout: Float?
    attr_reader memory_limit: Integer?
    attr_reader stdout_limit: Integer?
    attr_reader stderr_limit: Integer?
    attr_reader open_file_limit: Integer?
    attr_reader open_connection_limit: Integer?
    attr_reader connection_limit: Integer?
    attr_reader profile: Symbol
    attr_reader gvl: Symbol

    def self.new: (
      timeout: (Float | Integer)?,
      setup_timeout: (Float | Integer)?,
      memory_limit: Integer?,
      stdout_limit: Integer?,
      stderr_limit: Integer?,
      open_file_limit: Integer?,
      open_connection_limit: Integer?,
      connection_limit: Integer?,
      profile: Symbol,
      gvl: Symbol
    ) -> SandboxOptions

    def initialize: (
      timeout: (Float | Integer)?,
      setup_timeout: (Float | Integer)?,
      memory_limit: Integer?,
      stdout_limit: Integer?,
      stderr_limit: Integer?,
      open_file_limit: Integer?,
      open_connection_limit: Integer?,
      connection_limit: Integer?,
      profile: Symbol,
      gvl: Symbol
    ) -> void

    def to_h: () -> {
      timeout: Float?,
      setup_timeout: Float?,
      memory_limit: Integer?,
      stdout_limit: Integer?,
      stderr_limit: Integer?,
      open_file_limit: Integer?,
      open_connection_limit: Integer?,
      connection_limit: Integer?,
      profile: Symbol,
      gvl: Symbol
    }

    def value_budget: () -> Integer?
  end
end
