module Kobako
  module Catalog
    class Services
      RESERVED_NAMESPACE: String

      def initialize: () -> void

      def bind: (Symbol | String path, untyped object) -> self

      def bound?: (Symbol | String path) -> bool

      def lookup: (Symbol | String target) -> Kobako::Transport::Exposure

      def paths: () -> Array[String]

      private

      def validate_path!: (Symbol | String path) -> String

      def reserved?: (String path) -> bool

      def collision?: (String path) -> bool
    end
  end
end
