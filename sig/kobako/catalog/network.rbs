module Kobako
  module Catalog
    class Network < Data
      type tuple = [String, untyped]

      attr_reader name: String
      attr_reader entry: untyped

      def self.new: (name: untyped, entry: untyped) ?{ (Kobako::Network::Builder) -> void } -> Network

      def initialize: (name: untyped, entry: untyped) ?{ (Kobako::Network::Builder) -> void } -> void

      def key: () -> Grants::key

      def conflict: (Mount | Network other) -> String?

      def to_native: () -> tuple
    end
  end
end
