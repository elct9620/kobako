module Kobako
  module Catalog
    class Grants
      type key = [Symbol, String]

      type grant = Mount | Network

      def initialize: () -> void

      def register: (grant grant) -> nil

      def include?: (grant grant) -> bool
      def entries: (?Hash[key, grant] overrides) -> [Array[Mount::tuple], Array[Network::tuple]]
    end
  end
end
