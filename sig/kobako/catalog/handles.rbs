module Kobako
  module Catalog
    class Handles
      MAX_HANDLES: Integer

      def initialize: (?next_id: Integer) -> void

      def alloc: (untyped object) -> Kobako::Handle

      def fetch: (Integer id) -> untyped

      def exposure: (Integer id) -> Kobako::Transport::Exposure

      def size: () -> Integer

      private

      def ensure_capacity: () -> void

      def require_bound: (Integer id) -> void
    end
  end
end
