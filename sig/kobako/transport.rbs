module Kobako
  module Transport
    # The guest re-entry callable a dispatch hands to a Yielder: invoked
    # with the encoded yield args, it returns the encoded Yield Reply.
    # The ext's Kobako::Runtime::GuestYielder is the production conformer;
    # modelled structurally so the Transport layer needs no upward
    # dependency on Runtime.
    interface _GuestYielder
      def call: (String) -> [Symbol, String, String?]
    end

    # The per-invocation dispatch Proc, taking the routing fields the native
    # side already decoded off the core envelope and answering the arm and
    # body it puts on the Reply. Named here so the producer (Context) and the
    # consumer (Runtime) cannot declare it differently.
    type dispatch_proc = ^(String | Integer, String, bool, String, _GuestYielder) -> [bool, String, String?]

    # The Service registry a dispatch resolves constant-path targets
    # against. The Sandbox's Kobako::Catalog::Services is the
    # production conformer; modelled structurally so the Transport
    # layer needs no upward dependency on Catalog.
    interface _ServiceRegistry
      def lookup: (String target) -> untyped
    end
  end
end
