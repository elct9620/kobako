module Kobako
  class Runtime
    def self.default_path: () -> String

    def self.default_options: () -> {
      timeout: Float?,
      setup_timeout: Float?,
      memory_limit: Integer?,
      stdout_limit: Integer?,
      stderr_limit: Integer?,
      open_file_limit: Integer?,
      open_connection_limit: Integer?,
      connection_limit: Integer?,
      profile: Symbol,
      gvl: Symbol
    }

    def self.normalize_caps: (Hash[Symbol, untyped] caps) -> {
      timeout: Float?,
      setup_timeout: Float?,
      memory_limit: Integer?,
      stdout_limit: Integer?,
      stderr_limit: Integer?,
      open_file_limit: Integer?,
      open_connection_limit: Integer?,
      connection_limit: Integer?
    }

    def self.value_budget_of: (Integer? memory_limit) -> Integer?

    def self.from_path: (
      String path,
      timeout: (Float | Integer)?,
      setup_timeout: (Float | Integer)?,
      memory_limit: Integer?,
      stdout_limit: Integer?,
      stderr_limit: Integer?,
      open_file_limit: Integer?,
      open_connection_limit: Integer?,
      connection_limit: Integer?,
      profile: Symbol,
      gvl: Symbol
    ) -> Runtime

    type setup = [
      Array[String],
      Array[Kobako::Catalog::Snippets::tuple],
      Array[Kobako::Catalog::Flags::tuple],
      Array[Kobako::Catalog::Mount::tuple],
      Array[Kobako::Catalog::Network::tuple]
    ]

    def eval: (Kobako::Transport::dispatch_proc dispatch, setup setup, String source) -> Kobako::Snapshot

    def run: (
      Kobako::Transport::dispatch_proc dispatch,
      setup setup,
      String entrypoint,
      String payload
    ) -> Kobako::Snapshot

    def profile: () -> Symbol

    def compile: (Kobako::Context::preamble preamble) -> Array[String]?
  end
end
