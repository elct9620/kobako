module Kobako
  class Runtime
    def self.default_path: () -> String

    def self.from_path: (
      String path,
      (Float | Integer)? timeout_seconds,
      Integer? memory_limit,
      Integer? stdout_limit_bytes,
      Integer? stderr_limit_bytes,
      Symbol profile,
      Symbol gvl
    ) -> Runtime

    def eval: (
      Kobako::Transport::dispatch_proc dispatch,
      Array[String] paths,
      String source,
      Array[Kobako::Catalog::Snippets::tuple] snippets
    ) -> Kobako::Runtime::Snapshot

    def run: (
      Kobako::Transport::dispatch_proc dispatch,
      Array[String] paths,
      Array[Kobako::Catalog::Snippets::tuple] snippets,
      String entrypoint,
      String payload
    ) -> Kobako::Runtime::Snapshot

    def profile: () -> Symbol

    # Frame-scoped guest re-entry handle the ext hands the dispatch Proc as
    # its last argument — the production conformer of
    # +Kobako::Transport::_GuestYielder+, answering the Yield Reply already
    # split off the core envelope.
    class GuestYielder
      def call: (String args_bytes) -> [Symbol, String, String?]
    end

    # One invocation's result — the whole Snapshot the driver produced.
    class Snapshot
      def outcome: () -> [Symbol, String, Kobako::Outcome::panic_fields?]

      def trapped?: () -> bool

      def trap_kind: () -> Symbol?

      def trap_message: () -> String?

      def wall_time: () -> Float

      def memory_peak: () -> Integer

      def stdout: () -> String

      def stdout_truncated?: () -> bool

      def stderr: () -> String

      def stderr_truncated?: () -> bool
    end
  end
end
