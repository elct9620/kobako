module Kobako
  class Runtime
    def self.default_path: () -> String

    def self.validate_mount!: (untyped at, untyped access, untyped filesystem) -> nil

    def self.from_path: (
      String path,
      timeout: (Float | Integer)?,
      setup_timeout: (Float | Integer)?,
      memory_limit: Integer?,
      stdout_limit: Integer?,
      stderr_limit: Integer?,
      open_file_limit: Integer?,
      profile: Symbol,
      gvl: Symbol
    ) -> Runtime

    type setup = [
      Array[String],
      Array[Kobako::Catalog::Snippets::tuple],
      Array[Kobako::Catalog::Flags::tuple],
      Array[Kobako::Catalog::Mount::tuple]
    ]

    def eval: (Kobako::Transport::dispatch_proc dispatch, setup setup, String source) -> Kobako::Snapshot

    def run: (
      Kobako::Transport::dispatch_proc dispatch,
      setup setup,
      String entrypoint,
      String payload
    ) -> Kobako::Snapshot

    def profile: () -> Symbol

    def compile: (Kobako::Context::preamble preamble) -> Array[String]?
  end
end
