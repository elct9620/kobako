module Kobako
  class Fault < Data
    VALID_TYPES: Array[String]

    attr_reader type: String
    attr_reader message: String

    def self.new: (type: String, message: String) -> Fault

    def initialize: (type: String, message: String) -> void

    def with: (?type: String, ?message: String) -> Fault

    def ==: (untyped other) -> bool

    def hash: () -> Integer
  end
end
